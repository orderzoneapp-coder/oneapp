  "applications": [
    {
      "id": "nexus-home",
      "name": "NEXUS Home",
      "path": "nexus/index.html",
      "kind": "web-entry",
      "status": "production",
      "purpose": "Identify the master or delegated user, record login and logout through the deployed authentication service, show the fixed ONEAPP ownership Footer, and launch independent work apps without gating their local execution or depending on the company service.",
      "productionWrites": true,
      "navigatesTo": [
        "master-lookup",
        "customer-master",
        "merchops",
        "smart-input",
        "orderops",
        "dataops",
        "smart-parser",
        "export-center",
        "settings",
        "item-manager",
        "history-viewer",
        "orderq-vnext",
        "nexus-admin"
      ],
      "coreCapabilities": [
        "basic login and logout",
        "first-use delegated-user activation",
        "master or delegated-user identification",
        "per-user home-card and global-tab visibility projection without access gating",
        "independent work-app launcher",
        "fixed ownership Footer without server or identity dependencies"
      ],
      "dependencyMode": {
        "cachedSessionDisplay": "LOCAL_OPERATION",
        "sessionRefresh": "BACKGROUND_SYNC",
        "login": "SERVER_FINALIZE",
        "logoutAudit": "BACKGROUND_SYNC",
        "ownershipFooter": "STATIC_UI"
      },
      "offlinePolicy": "A cached unexpired home session and the fixed ownership Footer remain visible while authentication verification is delayed; company-service failure does not affect home, and work apps do not load the login runtime or wait for the authentication service.",
      "services": [
        "nexus-auth-gateway"
      ],
      "sharedContracts": [
        "nexus-auth"
      ]
    },
    {
      "id": "nexus-admin",
      "name": "NEXUS User Administration",
      "path": "nexus/admin/index.html",
      "kind": "web-entry",
      "status": "production",
      "purpose": "Let only OWNER_MASTER create delegated users, update display names and non-authoritative app visibility, suspend or restore use, reissue one-time activation codes, and review minimal immutable audit events without deletion, capability, service, or approval controls.",
      "productionWrites": true,
      "navigatesTo": [
        "nexus-home"
      ],
      "services": [
        "nexus-auth-gateway"
      ],
      "sharedContracts": [
        "nexus-auth"
      ],
      "dependencyMode": {
        "userRead": "SERVER_FINALIZE",
        "userWrite": "SERVER_FINALIZE",
        "auditRead": "SERVER_FINALIZE"
      },
      "offlinePolicy": "Authentication-service failure disables only administration; it does not redirect or block independent work-app entry and local work."
    },
    {
      "id": "nexus-company",
      "name": "NEXUS Company Profile",
      "path": "nexus/company.html",
      "kind": "web-entry",
      "status": "production",
      "purpose": "Let only OWNER_MASTER users with admin.company read and revise the server-authoritative company profile while preserving revision conflicts and audit writes.",
      "productionWrites": true,
      "navigatesTo": [
        "nexus-home"
      ],
      "services": [
        "nexus-auth-gateway"
      ],
      "sharedContracts": [
        "nexus-auth",
        "company-profile"
      ],
      "dependencyMode": {
        "profileRead": "SERVER_FINALIZE",
        "profileWrite": "SERVER_FINALIZE",
        "addressLookup": "BACKGROUND_SYNC"
      },
      "offlinePolicy": "Server failure leaves the last NEXUS home Snapshot unchanged and is never converted into an empty company record."
    },
