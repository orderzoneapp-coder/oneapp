{
  "schemaVersion": "1.3.0",
  "updatedAt": "2026-08-23",
  "repository": {
    "fullName": "orderzoneapp-coder/oneapp",
    "defaultBranch": "main",
    "architectureDocument": "APP_ARCHITECTURE.md"
  },
  "statusDefinitions": {
    "planned": "Design stage; must not be a production dependency.",
    "pilot": "Controlled validation stage with protected production writes.",
    "production": "Supported operational component.",
    "deprecated": "Migration or read-only stage with a documented replacement.",
    "archived": "Retained in Git history or releases and not deployed as an active entry point."
  },
  "applications": [
    {
      "id": "nexus",
      "name": "NEXUS",
      "path": "nexus/index.html",
      "kind": "web-entry",
      "status": "production",
      "purpose": "Provide the shared ONEAPP application header and navigation entry point without adding dashboard content or production data writes.",
      "navigatesTo": [
        "orderops",
        "orderq-vnext",
        "dataops",
        "merchops",
        "smart-parser",
        "master-lookup",
        "item-manager"
      ],
      "sharedContracts": [
        "nexus-header"
      ]
    },
    {
      "id": "merchops",
      "name": "MerchOps",
      "path": "MerchOps.html",
      "kind": "web-entry",
      "status": "production",
      "purpose": "Review and apply product master, pricing, promotion, and Excel-based product-information work while preserving read-only protection for stopped products.",
      "navigatesTo": [
        "smart-parser",
        "export-center",
        "settings",
        "history-viewer"
      ],
      "services": [
        "cloud-sync"
      ],
      "sharedContracts": [
        "nexus-header",
        "product-master",
        "change-history",
        "parser-dictionary",
        "pricing-rules",
        "mapping-config",
        "table-view-config",
        "cloud-url",
        "stop-management"
      ]
    },
    {
      "id": "dataops",
      "name": "DataOps",
      "path": "DataOps.html",
      "kind": "web-entry",
      "status": "production",
      "purpose": "Analyze purchase, sales, inventory, stock ledger, cost, and performance information, including administrator-reviewed out-of-list inventory products from the confirmed local master.",
      "productionWrites": true,
      "runtimeDependencies": [
        "core-engine"
      ],
      "services": [
        "cloud-sync"
      ],
      "sharedContracts": [
        "nexus-header",
        "product-master",
        "change-history",
        "pricing-rules",
        "mapping-config",
        "cloud-url",
        "stop-management",
        "dataops-inventory-master-resume"
      ]
    },
    {
      "id": "smart-parser",
      "name": "Smart Parser",
      "path": "SmartParser.html",
      "kind": "web-entry",
      "status": "production",
      "purpose": "Parse external documents, manage supplier exclusions and stopped or sold-out products, apply approved changes directly to the product master, and record changes in shared history.",
      "navigatesTo": [
        "merchops",
        "settings",
        "history-viewer"
      ],
      "sharedContracts": [
        "nexus-header",
        "product-master",
        "change-history",
        "parser-dictionary",
        "pricing-rules",
        "parser-supplier-exclusions",
        "stop-management"
      ]
    },
    {
      "id": "export-center",
      "name": "Export Center",
      "path": "export_center.html",
      "kind": "web-entry",
      "status": "production",
      "purpose": "Validate selected work, generate Excel output, and apply approved master changes.",
      "navigatesTo": [
        "merchops"
      ],
      "sharedContracts": [
        "product-master",
        "change-history"
      ]
    },
    {
      "id": "settings",
      "name": "Settings",
      "path": "settings.html",
      "kind": "web-entry",
      "status": "production",
      "purpose": "Manage mappings, pricing policies, columns, table views, cloud URL, and shared configuration.",
      "navigatesTo": [
        "merchops"
      ],
      "runtimeDependencies": [
        "core-engine"
      ],
      "services": [
        "cloud-sync"
      ],
      "sharedContracts": [
        "product-master",
        "change-history",
        "parser-dictionary",
        "pricing-rules",
        "mapping-config",
        "table-view-config",
        "cloud-url"
      ]
    },
    {
      "id": "master-lookup",
      "name": "Master",
      "path": "Master.html",
      "kind": "web-entry",
      "status": "pilot",
      "purpose": "Provide product-master lookup and a controlled, administrator-reviewed add/update workflow with cloud synchronization.",
      "productionWrites": true,
      "runtimeDependencies": [
        "core-engine"
      ],
      "sharedContracts": [
        "nexus-header",
        "product-master",
        "change-history"
      ]
    },
    {
      "id": "item-manager",
      "name": "Item Manager",
      "path": "Item_manager.html",
      "kind": "web-entry",
      "status": "pilot",
      "purpose": "Provide category-based product lookup and controlled product-management writes.",
      "productionWrites": true,
      "runtimeDependencies": [
        "core-engine"
      ],
      "sharedContracts": [
        "nexus-header",
        "product-master",
        "change-history"
      ]
    },
    {
      "id": "history-viewer",
      "name": "History Viewer",
      "path": "history_viewer.html",
      "kind": "web-entry",
      "status": "production",
      "purpose": "Inspect product-change history and price trends.",
      "navigatesTo": [
        "merchops"
      ],
      "services": [
        "cloud-sync"
      ],
      "sharedContracts": [
        "product-master",
        "change-history",
        "cloud-url"
      ]
    },
    {
      "id": "core-engine",
      "name": "ONEAPP Core Engine",
      "path": "coreEngine.js",
      "kind": "shared-library",
      "status": "production",
      "purpose": "Provide common storage, pricing, history, export, cloud, and master-data utilities.",
      "modules": [
        "ONEAPP.STORAGE",
        "ONEAPP.PRICING",
        "ONEAPP.HISTORY",
        "ONEAPP.EXPORT",
        "ONEAPP.CLOUD",
        "ONEAPP.MASTER"
      ],
      "integrationNote": "Settings explicitly loads this library. Other production pages still contain overlapping local implementations and require compatibility validation before consolidation."
    },
    {
      "id": "orderops",
      "name": "ORDER Q",
      "path": "orderops/list.html",
      "kind": "web-entry",
      "status": "pilot",
      "purpose": "Manage the shipment workflow from customer order through available inventory, purchasing, staged shipment completion, and reviewed outbound workbooks.",
      "owner": "shipping-operations",
      "productionWrites": true,
      "publicEntries": [
        "orders.html",
        "orderops_list.html",
        "orderops/list.html"
      ],
      "services": [
        "cloud-sync"
      ],
      "sharedContracts": [
        "nexus-header",
        "cloud-url",
        "shipping-purchase-plan"
      ]
    },
    {
      "id": "orderq-vnext",
      "name": "ORDER Q vNext",
      "path": "orderq/index.html",
      "kind": "web-entry-group",
      "status": "pilot",
      "purpose": "Provide manual and text order intake, source-preserving historical collection, order-to-sales fulfillment evidence, and revisioned cloud synchronization without changing the existing OrderOps compatibility route.",
      "owner": "shipping-operations",
      "productionWrites": true,
      "entries": [
        "orderq/index.html",
        "orderq/input.html",
        "orderq/parser.html",
        "orderq/collector.html",
        "orderq/cloud.html"
      ],
      "services": [
        "cloud-sync"
      ],
      "sharedContracts": [
        "nexus-header",
        "cloud-url",
        "orderq-vnext-sync",
        "product-master"
      ]
    },
    {
      "id": "cloud-sync",
      "name": "ONEAPP Cloud Sync",
      "path": "code.gs",
      "kind": "google-apps-script-service",
      "status": "production",
      "purpose": "Back up and restore product master, history, shared configuration, the finalized DataOps inventory snapshot, explicitly saved Shipping purchase-plan revisions, and token-protected ORDER Q vNext incremental records.",
      "apiActions": {
        "post": [
          "initSync",
          "chunk_master",
          "chunk_history",
          "config",
          "dataops_snapshot_commit",
          "dataops_snapshot_get",
          "shipping_plan_save",
          "shipping_plan_list",
          "shipping_plan_get",
          "orderq_sync_push",
          "orderq_sync_pull",
          "orderq_order_head"
        ],
        "get": [
          "full",
          "master_only",
          "config_only"
        ]
      },
      "sharedContracts": [
        "product-master",
        "change-history",
        "parser-dictionary",
        "pricing-rules",
        "mapping-config",
        "table-view-config",
        "cloud-url",
        "dataops-inventory-snapshot",
        "shipping-purchase-plan"
      ]
    }
  ],
  "sharedDataContracts": [
    {
      "id": "nexus-header",
      "owner": "nexus",
      "consumers": [
        "nexus/index.html",
        "Master.html",
        "Item_manager.html",
        "MerchOps.html",
        "SmartParser.html",
        "DataOps.html",
        "orders.html",
        "orderops_list.html",
        "orderops/list.html",
        "orderops/input.html",
        "orderq/input.html",
        "orderq/parser.html"
      ],
      "schemaVersion": "NEXUS_HEADER_V1",
      "resources": {
        "component": "nexus/common/nexus-top.js",
        "configuration": "nexus/common/apps-config.js",
        "statusApi": "window.NEXUS_TOP.reportStatus",
        "leaveGuardEvent": "nexus:before-navigate",
        "preferencePrefix": "oneapp.nexus.v1."
      }
    },
    {
      "id": "orderq-vnext-sync",
      "owner": "orderq-vnext",
      "consumers": [
        "orderq/index.html",
        "orderq/input.html",
        "orderq/parser.html",
        "orderq/collector.html",
        "orderq/cloud.html"
      ],
      "schemaVersion": "ONEAPP_ORDERQ_SYNC_V1",
      "localDatabase": "oneapp-orderq-vnext",
      "accessTokenProperty": "ONEAPP_ORDERQ_ACCESS_TOKEN",
      "compatibilityTokenProperty": "ONEAPP_SHIPPING_PLAN_ACCESS_TOKEN",
      "resources": {
        "cloudActions": [
          "orderq_sync_push",
          "orderq_sync_pull",
          "orderq_order_head"
        ],
        "cloudSheets": [
          "ORDER",
          "ORDER_ITEM",
          "ORDER_EVENT",
          "CUSTOMER_MASTER",
          "PRODUCT_MASTER_ORDERQ",
          "IMPORT_BATCH",
          "SOURCE_RECORD",
          "SALES_DOCUMENT",
          "SALES_LINE",
          "PURCHASE_DOCUMENT",
          "PURCHASE_LINE",
          "LEDGER_DOCUMENT",
          "LEDGER_LINE",
          "INVENTORY_SNAPSHOT",
          "INVENTORY_LINE",
          "HISTORICAL_ORDER",
          "HISTORICAL_ORDER_LINE",
          "FULFILLMENT_LINK",
          "PARSER_EVIDENCE",
          "COLLECTOR_SETTING",
          "ORDER_TXN_LOG",
          "SYNC_META"
        ]
      }
    },
    {
      "id": "shipping-purchase-plan",
      "owner": "orderops",
      "consumers": [
        "orders.html",
        "orderops_list.html",
        "orderops/list.html"
      ],
      "schemaVersion": "ONEAPP_SHIPPING_PURCHASE_PLAN_V1",
      "workspaceSchemaVersion": "shipping-workspace/v2",
      "localRecoverySchemaVersion": "shipping-local-recovery/v1",
      "resources": {
        "indexedDb": {
          "database": "ONEAPPShippingManagementDB",
          "store": "workspaces"
        },
        "localStorage": [
          "oneapp.shipping.recovery.pointer.v1",
          "oneapp.shipping.recovery.meta.v1"
        ],
        "cloud": [
          "shipping_plan_save",
          "shipping_plan_list",
          "shipping_plan_get",
          "ShippingPlanStaging",
          "ShippingPlanHistory",
          "ShippingPlanIndex",
          "ONEAPP_SHIPPING_PLAN_ACCESS_TOKEN"
        ]
      }
    },
    {
      "id": "dataops-inventory-snapshot",
      "owner": "dataops",
      "consumers": [
        "DataOps.html",
        "MerchOps.html"
      ],
      "schemaVersion": "ONEAPP_DATAOPS_SNAPSHOT_V1",
      "columns": [
        "단위",
        "품목코드",
        "품명",
        "규격",
        "재고",
        "기록",
        "거래",
        "구매가",
        "기본",
        "적요",
        "행사가"
      ],
      "resources": {
        "cloud": [
          "dataops_snapshot_commit",
          "dataops_snapshot_get",
          "DataOpsSnapshot_A",
          "DataOpsSnapshot_B",
          "ONEAPP_DATAOPS_CURRENT_SLOT"
        ]
      }
    },
    {
      "id": "dataops-inventory-master-resume",
      "owner": "dataops",
      "consumers": [
        "DataOps.html"
      ],
      "schemaVersion": "dataops-inventory-master-resume/v1",
      "purpose": "Identify and retry sale-resume work after the related DataOps inventory snapshot has already finalized successfully.",
      "resources": {
        "localStorage": [
          "dataops_inventory_master_resume_v1"
        ]
      },
      "rollback": "Reverting the feature stops new records; unresolved records are retained for manual sale-status review and must not trigger another inventory closing. Successfully resumed records are removed after verified master/history commit."
    },
    {
      "id": "product-master",
      "owner": "merchops",
      "consumers": [
        "orderq/input.html"
      ],
      "resources": {
        "indexedDb": {
          "database": "MerchOpsDB",
          "store": "master_products",
          "keys": [
            "merchMaster_v870"
          ]
        },
        "localStorage": [
          "merchMaster_v870",
          "merchMaster_sync_trigger"
        ],
        "cloud": [
          "master",
          "master_only",
          "chunk_master"
        ]
      }
    },
    {
      "id": "change-history",
      "owner": "merchops",
      "resources": {
        "localStorage": [
          "merchHistory_v870"
        ],
        "cloud": [
          "history",
          "chunk_history"
        ]
      }
    },
    {
      "id": "parser-dictionary",
      "owner": "smart-parser",
      "resources": {
        "localStorage": [
          "parserDict_v870"
        ],
        "cloudConfigField": "dict"
      }
    },
    {
      "id": "parser-supplier-exclusions",
      "owner": "smart-parser",
      "consumers": [
        "SmartParser.html"
      ],
      "resources": {
        "localStorage": [
          "smartParserExcludeDict_v3012",
          "smartParserExcludeDict_backup_v3015"
        ]
      }
    },
    {
      "id": "stop-management",
      "owner": "smart-parser",
      "consumers": [
        "SmartParser.html",
        "MerchOps.html",
        "DataOps.html"
      ],
      "writerPolicy": "SmartParser owns general stop/resume management. DataOps may perform resume-only writes through masterAddUpdate.js after a finalized positive inventory count, using the existing atomic master/history/linked-state contract.",
      "resources": {
        "indexedDb": {
          "database": "MerchOpsDB",
          "keys": [
            "merchStoppedProducts_v2",
            "pending_shop_status"
          ]
        },
        "localStorage": [
          "merchStoppedProducts_v2",
          "pendingShopStatus",
          "merchStopManager_sync_trigger"
        ]
      }
    },
    {
      "id": "pricing-rules",
      "owner": "settings",
      "resources": {
        "localStorage": [
          "merchMarginRules_v878"
        ],
        "cloudConfigField": "rules"
      }
    },
    {
      "id": "mapping-config",
      "owner": "settings",
      "resources": {
        "localStorage": [
          "merchMappings_v870",
          "merchMasterLinks_v870"
        ]
      }
    },
    {
      "id": "table-view-config",
      "owner": "settings",
      "resources": {
        "localStorage": [
          "merchActiveTableTarget_v1",
          "merchActiveTableViewId_v1",
          "merchTableViewPresets_v1"
        ]
      }
    },
    {
      "id": "cloud-url",
      "owner": "settings",
      "resources": {
        "primaryLocalStorage": "oneapp_cloud_sync_url_v1",
        "legacyLocalStorage": "merchCloudUrl_v870"
      }
    }
  ],
