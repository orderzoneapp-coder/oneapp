  "changeRules": [
    {
      "change": "layout-or-button-placement",
      "review": [
        "affected-page",
        "navigation-smoke-test"
      ]
    },
    {
      "change": "product-field-or-excel-mapping",
      "review": [
        "merchops",
        "smart-parser",
        "dataops",
        "export-center",
        "settings",
        "history-viewer"
      ]
    },
    {
      "change": "pricing-or-margin",
      "review": [
        "core-engine",
        "merchops",
        "dataops",
        "smart-parser",
        "export-center"
      ]
    },
    {
      "change": "storage-key-or-indexeddb-schema",
      "review": [
        "all-contract-consumers",
        "migration",
        "rollback"
      ]
    },
    {
      "change": "cloud-action-or-payload",
      "review": [
        "cloud-sync",
        "core-engine",
        "all-api-callers"
      ]
    },
    {
      "change": "navigation-path-or-filename",
      "review": [
        "all-web-entry-points",
        "deployment-routes"
      ]
    },
    {
      "change": "function-key-behavior",
      "review": [
        "owning-application",
        "keyboard-handler",
        "visible-button",
        "downstream-workflow",
        "application-specific-smoke-test"
      ],
      "policy": "Function keys are application-owned. The same key must not be assumed to have the same business meaning across applications."
    }
  ],
  "planningPolicy": {
    "allowedProductionDependency": false,
    "requiredFields": [
      "id",
      "name",
      "proposedPath",
      "purpose",
      "owner",
      "inputs",
      "outputs",
      "sharedContracts",
      "upstream",
      "downstream",
      "validation",
      "rollback",
      "targetStatus"
    ]
  },
  "plannedApplications": [
    {
      "id": "trend-report",
      "name": "Trend Report",
      "proposedPath": "trend_report.html",
      "kind": "web-entry",
      "status": "planned",
      "developmentState": "on-hold",
      "purpose": "Turn MerchOps and DataOps results into decision-support insights after the core applications mature.",
      "owner": "analytics-roadmap",
      "inputs": [
        "product-master",
        "change-history",
        "inventory and performance results"
      ],
      "outputs": [
        "trend insights",
        "decision-support report"
      ],
      "sharedContracts": [
        "product-master",
        "change-history"
      ],
      "upstream": [
        "merchops",
        "dataops"
      ],
      "downstream": [],
      "productionWrites": false,
      "validation": [
        "Every reported metric identifies its source and period.",
        "Results reconcile with the source application totals.",
        "The report cannot mutate production data."
      ],
      "rollback": "Remove pilot navigation and retain generated reports only as non-authoritative artifacts.",
      "targetStatus": "pilot",
      "resumeAfter": [
        "MerchOps data contracts are stable.",
        "DataOps analysis outputs are stable."
      ]
    },
    {
      "id": "image-generator",
      "name": "Image Generator",
      "proposedPath": "image_generator.html",
      "kind": "utility",
      "status": "planned",
      "developmentState": "on-hold",
      "purpose": "Create offline-sales images and print materials for market-price changes and promotional products.",
      "owner": "sales-output-roadmap",
      "inputs": [
        "MerchOps F9 review payload",
        "approved product and promotion information"
      ],
      "outputs": [
        "offline sales image",
        "print-ready sales material"
      ],
      "sharedContracts": [
        "product-master"
      ],
      "upstream": [
        "merchops",
        "export-center"
      ],
      "downstream": [
        "print-output"
      ],
      "productionWrites": false,
      "workflowIntent": "MerchOps F9 review leads to a downstream F10 print action after the output workflow is approved.",
      "validation": [
        "Printed values match the approved review payload.",
        "Preview and print layouts remain legible at the target paper size.",
        "Image generation cannot mutate product master data."
      ],
      "rollback": "Disable the pilot output entry and continue using existing Excel or manual print output.",
      "targetStatus": "pilot",
      "resumeAfter": [
        "MerchOps Export Center workflow is stable.",
        "Output and print validation rules are approved."
      ]
    }
  ],
  "recoveryPolicy": {
    "sourceOfTruth": "Git history and the main branch",
    "preferredMethods": [
      "stable-tag",
      "pull-request-revert",
      "rollback-pull-request"
    ],
    "testCopiesAreBackups": false,
    "optionalPreviewPolicy": "Keep at most one explicitly named preview or stable entry point per operational need, with an owner and verification date."
  },
  "functionKeyPolicy": {
    "applicationOwned": true,
    "crossApplicationSemanticUnification": false,
    "assignments": {
      "merchops": {
        "F7": "Apply current work to the MerchOps master after atomic storage and history verification.",
        "F8": "Create the Excel output from current work without changing the master.",
        "F9": "Open Export Center for review and downstream output."
      },
      "dataops": {
        "F6": "Open one out-of-list product search row below the selected inventory row using the confirmed local master.",
        "F8": "Unassigned.",
        "F9": "Create the combined workbook, finalize the DataOps inventory snapshot, then independently resume stopped master products with positive counted inventory.",
        "F10": "Open the print output workflow."
      },
      "orderops": {
        "F3": "Focus the integrated search field and keep the text caret ready for immediate input.",
        "F7": "Print the current visible OrderOps tab, filters, rows, column visibility, and column order on A4 portrait.",
        "F8": "Create the complete integrated OrderOps workbook independently of current screen filters, hidden columns, or column order."
      }
    }
  },
  "developmentRoadmap": [
    {
      "phase": 1,
      "name": "Baseline and checks",
      "scope": [
        "inventory production entry points",
        "record shared contracts",
        "define application-specific smoke tests"
      ]
    },
    {
      "phase": 2,
      "name": "Client safety",
      "status": "in-progress",
      "scope": [
        "validate imports before apply",
        "protect browser storage writes",
        "show actionable errors"
      ],
      "delivered": [
        "block master Excel apply when rows have missing or duplicate product codes",
        "limit master imports to supported file types, 25 MB, and 100000 rows",
        "verify shared storage writes and automatically restore master/history after an apply failure",
        "show persistent actionable errors in the master database management screen"
      ]
    },
    {
      "phase": 3,
      "name": "Cloud protection",
      "scope": [
        "validate cloud actions and payloads",
        "protect restore paths",
        "improve failure reporting"
      ]
    },
    {
      "phase": 4,
      "name": "Atomic backup and rollback",
      "scope": [
        "version stable releases",
        "verify rollback procedure",
        "avoid duplicate recovery files"
      ]
    },
    {
      "phase": 5,
      "name": "Application-specific output stability",
      "subphases": [
        {
          "id": "5A",
          "application": "merchops",
          "shortcuts": {
