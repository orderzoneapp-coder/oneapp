    {
      "id": "foundation-bplus-backup",
      "owner": "cloud-sync",
      "consumers": [
        "Master.html",
        "Item_manager.html",
        "partner_db.html",
        "coreEngine.js",
        "orderq/customer-master.js",
        "orderq/customer-source-import.js",
