      ],
      "schemaVersion": "FOUNDATION_BACKUP_V1",
      "purpose": "Keep product and customer work Local Primary while writing immutable server revisions, blocking stale or ahead lineages, quarantining the legacy Customer sync queue, and allowing only administrator-previewed restore application.",
      "writerPolicy": "Product and Customer local commits are authoritative for daily work. Automatic traffic is one-way backup only. Server payloads may change local data only after version verification, comparison, safety snapshot creation, explicit administrator approval, atomic replacement, and reread verification.",
      "resources": {
        "client": "nexus/foundation/foundation-backup.js",
        "customerClient": "orderq/customer-foundation-backup.js",
        "serverModule": "foundation-backup.gs",
        "gateway": "nexus/server/nexus-auth-gateway.gs",
        "productStateKey": "oneapp.foundation.product-backup-state.v1",
        "deviceKey": "oneapp.foundation.device-id.v1",
        "orderqDatabase": {
          "database": "oneapp-orderq-vnext",
          "version": 17,
          "stores": [
            "foundationBackupOutbox",
            "foundationRecoverySnapshots",
            "foundationRecoveryAudit",
            "foundationLegacyQuarantine"
          ]
        },
        "serverSheets": [
          "FoundationBackupHead",
          "FoundationBackupVersion",
          "FoundationBackupChunk",
          "FoundationCustomerEvent",
          "FoundationDevice",
          "FoundationPrimary",
          "FoundationOperationResult",
          "FoundationRestoreAudit"
        ],
        "gatewayOperations": [
          "foundation.backup.head_read",
          "foundation.backup.product_write",
          "foundation.backup.customer_events_write",
          "foundation.backup.customer_snapshot_write",
          "foundation.backup.version_list",
          "foundation.backup.version_read",
          "foundation.backup.restore_audit_write",
          "foundation.device.status_read",
          "foundation.device.register",
          "foundation.device.promote"
        ],
        "featureFlags": [
          "BPLUS_BACKUP_ENABLED",
          "BPLUS_AUTO_PULL_DISABLED",
          "BPLUS_PRIMARY_GUARD_MODE",
          "BPLUS_CUSTOMER_RECOVERY_COMPLETED",
          "BPLUS_SHADOW_COMPARE_ENABLED"
        ]
      },
      "rollback": "Disable BPLUS_BACKUP_ENABLED and restore the previous static and Apps Script immutable versions. Never re-enable automatic Customer Pull, delete immutable versions/events, or regenerate productId/customerId. Additive OrderQ v17 stores remain readable and may be ignored by earlier code."
    },
    {
      "id": "smartinput-local-data",
      "owner": "smart-input",
      "consumers": [
        "smartinput/index.html"
      ],
      "schemaVersion": "ONEAPP_SMARTINPUT_LOCAL_V4",
      "purpose": "Preserve SmartInput device-local settings, relationships, estimates, source images, and revisioned input templates. Upgrading from v3 creates only inputTemplates. Existing-template imports are value-only and all structural writes are rejected before an IndexedDB transaction begins.",
      "resources": {
        "indexedDb": {
          "database": "oneapp-smartinput",
          "version": 4,
          "stores": [
            "settings",
            "customerLinkGroups",
            "temporaryCustomers",
            "customerAliasMappings",
            "estimates",
            "sourceImages",
            "inputTemplates"
          ]
        },
        "localStorage": [
          "oneapp.smartinput.relationships.v1",
          "oneapp.smartinput.draft.v1",
          "oneapp.smartinput.drafts.v1",
          "oneapp.smartinput.delivery-history.v1"
        ]
      },
      "rollback": "A code rollback to v3 leaves the additive inputTemplates store unused while every pre-v4 store remains readable and unchanged. Do not delete or downgrade the database; a later v4 load can resume the saved templates."
    },
